# Production API Base URL (leave empty to use relative /api/v1 if on same domain or reverse proxy)
NEXT_PUBLIC_API_URL=https://api.allabout.skin/api/v1
NEXT_PUBLIC_SITE_URL=https://allabout.skin

# Google Gemini Vision & AI Skincare Integration (Required on Serverless / Vercel runtime)
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Modelo de Gemini a utilizar (por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash


# Solo desarrollo: contraseña de las cuentas de prueba para la barra DEV (RolePortalBar). Déjala vacía en producción.
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=

# Cuotas del análisis de imagen (/api/ai/scan-image). Todas opcionales.
# Secreto para firmar la cookie de análisis gratis; si falta, se reinicia con cada arranque del servidor.
SCAN_QUOTA_SECRET=
SCAN_FREE_PER_DEVICE=2
SCAN_ANON_PER_IP_DAY=3
SCAN_USER_PER_DAY=20
SCAN_GLOBAL_PER_DAY=500
